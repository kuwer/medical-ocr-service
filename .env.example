# Port exposed by the service
PORT=3000

# Send requests as: Authorization: Bearer $AUTH_TOKEN
AUTH_TOKEN=replace-with-a-random-token

# Get a key from https://www.datalab.to/settings
DATALAB_API_KEY=replace-with-datalab-api-key

# Optional Marker settings
MARKER_MODE=balanced
MARKER_POLL_TIMEOUT_SECONDS=120
